# ════════════════════════════════════════════════════════
# AKSOY GROUP — .htaccess
# ════════════════════════════════════════════════════════

# UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# Index dosyası
DirectoryIndex index.php index.html

# Listing kapalı
Options -Indexes -MultiViews
ServerSignature Off

# ── HASSAS DOSYA / KLASÖR KORUMASI ──────────────────────
<FilesMatch "(^\.|\.(env|sql|md|json|log|sh|bak|swp|orig)$)">
    Require all denied
</FilesMatch>

<FilesMatch "^(config\.php|config\.example\.php|composer\.(json|lock)|manifest\.json)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 (?i)/(\.git|\.github|migrations|logs|includes|vendor)(/|$)

# ── HSTS + GÜVENLİK HEADER'LARI ────────────────────────
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ── REWRITE ENGINE ─────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS zorla
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # www → root
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Trailing slash kaldır (root hariç)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Sektör: /sektor/{slug}
    RewriteRule ^sektor/([a-z0-9-]+)/?$ /sektor/index.php?slug=$1 [QSA,L]

    # Şirket: /sirket/{slug}
    RewriteRule ^sirket/([a-z0-9-]+)/?$ /sirket/index.php?slug=$1 [QSA,L]

    # Sayfa: /sayfa/{slug}
    RewriteRule ^sayfa/([a-z0-9-]+)/?$ /sayfa/index.php?slug=$1 [QSA,L]

    # Yönetim Kurulu (özel sayfa, ag_pages değil)
    RewriteRule ^yonetim-kurulu/?$ /yonetim-kurulu.php [QSA,L]
    RewriteRule ^yonetim-kurulu/([a-z0-9-]+)/?$ /yonetim-kurulu.php?slug=$1 [QSA,L]

    # Haber listesi
    RewriteRule ^haberler/?$ /haber/index.php [QSA,L]
    # Haber detay: /haber/{slug}
    RewriteRule ^haber/([a-z0-9-]+)/?$ /haber/detay.php?slug=$1 [QSA,L]

    # Kısayollar: /hakkimizda, /iletisim, /kariyer, vs.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/?$ /sayfa/index.php?slug=$1 [QSA,L]
</IfModule>

# ── SIKIŞTIRMA (LiteSpeed/mod_deflate) ────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# ── ÖNBELLEK ────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ── PHP HATA AYARLARI (production) ─────────────────────
php_flag display_errors Off
php_value max_execution_time 60
php_value memory_limit 256M
php_value post_max_size 50M
php_value upload_max_filesize 25M

# ── HATA SAYFALARI ─────────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php
